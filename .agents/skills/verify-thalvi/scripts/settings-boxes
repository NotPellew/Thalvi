#!/usr/bin/env bash
# Layout check of one Settings page in Chromium (the UI's fake backend), at each window size:
# every listed element, scrolled into view vertically, is visible, wholly inside the window and unoccluded,
# and no two listed elements overlap. Exit 1 on a failed check.
# Usage: settings-boxes PAGE WxH[,WxH...] OUT.json ROLE=NAME...   (PAGE is the sidebar button's name)
set -euo pipefail
[ $# -ge 4 ] || { sed -n 2,5p "$0" >&2; exit 2; }
root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
ui=$root/crates/thalvi-app/ui
[ -d "$ui/node_modules/playwright-core" ] || { echo "settings-boxes: run npm ci in $ui first" >&2; exit 2; }
set -- "$1" "$2" "$(realpath -m "$3")" "${@:4}"
cd "$ui"
node --input-type=module - "$@" <<'EOF'
import { createServer } from "vite";
import { chromium } from "playwright-core";
import { writeFileSync } from "node:fs";

const [page, sizes, out, ...specs] = process.argv.slice(2);
const wanted = specs.map((s) => {
  const at = s.indexOf("=");
  if (at < 1) throw new Error(`expected ROLE=NAME, got ${s}`);
  return { role: s.slice(0, at), name: s.slice(at + 1) };
});
const server = await createServer({ server: { host: "127.0.0.1", port: 0 }, logLevel: "silent" });
await server.listen();
const browser = await chromium.launch({ headless: true });
const report = [];
let failed = false;
try {
  for (const size of sizes.split(",")) {
    const [width, height] = size.split("x").map(Number);
    const tab = await browser.newPage({ viewport: { width, height } });
    await tab.goto(`${server.resolvedUrls.local[0]}settings.html?fake&at=0`);
    await tab.getByRole("navigation", { name: "Settings pages" }).getByRole("button", { name: page, exact: true }).click();
    const locators = wanted.map((w) => tab.getByRole(w.role, { name: w.name, exact: true }).first());
    await locators.at(-1).waitFor({ state: "attached", timeout: 10_000 });
    const boxes = [];
    for (const [i, loc] of locators.entries()) {
      const label = `${wanted[i].role}=${wanted[i].name}`;
      if ((await loc.count()) === 0) { boxes.push({ label, problems: ["missing"] }); continue; }
      await loc.scrollIntoViewIfNeeded();
      // Only vertical scrolling is legitimate: undo any sideways scroll before measuring.
      const seen = await loc.evaluate((el) => {
        const scrolled = [document.scrollingElement, ...document.querySelectorAll("*")].filter((e) => e && e.scrollLeft !== 0);
        for (const e of scrolled) e.scrollLeft = 0;
        const r = el.getBoundingClientRect();
        const style = getComputedStyle(el);
        const hit = document.elementFromPoint(r.x + r.width / 2, r.y + r.height / 2);
        return { x: r.x, y: r.y, w: r.width, h: r.height, visible: style.visibility !== "hidden" && style.display !== "none" && r.width > 0 && r.height > 0,
          unoccluded: hit !== null && (el.contains(hit) || hit.contains(el) || (el.labels ?? []).length > 0 && [...el.labels].some((l) => l.contains(hit))) };
      });
      const problems = [];
      if (!seen.visible) problems.push("not visible");
      if (seen.x < 0 || seen.y < 0 || seen.x + seen.w > width + 0.5 || seen.y + seen.h > height + 0.5) problems.push("outside the window");
      if (!seen.unoccluded) problems.push("covered at its centre");
      boxes.push({ label, ...seen, problems });
    }
    // Overlap is judged in page coordinates, with every element measured at the same scroll.
    await tab.evaluate(() => document.querySelectorAll("*").forEach((e) => { if (e.scrollTop) e.scrollTop = 0; }));
    const rects = [];
    for (const loc of locators) rects.push((await loc.count()) ? await loc.evaluate((el) => {
      const r = el.getBoundingClientRect();
      return { x: r.x, y: r.y, w: r.width, h: r.height };
    }) : null);
    const handles = await Promise.all(locators.map(async (l) => ((await l.count()) ? l.elementHandle() : null)));
    for (let a = 0; a < rects.length; a++) for (let b = a + 1; b < rects.length; b++) {
      const p = rects[a], q = rects[b];
      if (!p || !q) continue;
      const nested = await tab.evaluate(([x, y]) => x.contains(y) || y.contains(x), [handles[a], handles[b]]);
      if (nested) continue;
      if (p.x < q.x + q.w - 0.5 && q.x < p.x + p.w - 0.5 && p.y < q.y + q.h - 0.5 && q.y < p.y + p.h - 0.5) {
        boxes[a].problems.push(`overlaps ${boxes[b].label}`);
      }
    }
    for (const b of boxes) if (b.problems.length) failed = true;
    report.push({ size, boxes });
    console.log(`${size}: ${boxes.filter((b) => !b.problems.length).length}/${boxes.length} pass`);
    for (const b of boxes) if (b.problems.length) console.log(`  FAIL ${b.label}: ${b.problems.join("; ")}`);
    await tab.close();
  }
} finally {
  await browser.close();
  await server.close();
}
writeFileSync(out, JSON.stringify(report, null, 1));
process.exit(failed ? 1 : 0);
EOF
