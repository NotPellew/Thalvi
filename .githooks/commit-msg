#!/bin/sh
# Mirrors the PR title check: type(optional scope): lowercase summary.
# Git's own Merge, Revert, fixup!, squash! and amend! subjects pass through.
subject=$(head -n 1 "$1")
case "$subject" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac
pattern='^(feat|fix|docs|refactor|test|chore|ci|build|perf)(\([a-z0-9-]+\))?!?: [^A-Z].*'
if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  echo "commit-msg: subject must be 'type(scope): summary' with a lowercase summary" >&2
  echo "commit-msg: types: feat fix docs refactor test chore ci build perf" >&2
  exit 1
fi
