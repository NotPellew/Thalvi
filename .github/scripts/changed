#!/usr/bin/env bash
# Prints the units the changes from BASE to HEAD affect, space-separated,
# `none` when only Markdown outside crates/ and speech/ changed, or
# `all` when any change can affect everything or the diff can't be read.
# Units: desktop app desktop-ui speech issues.
set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "usage: $0 BASE HEAD" >&2
  exit 2
fi

if [[ $(git rev-parse --is-shallow-repository) == true ]] ||
  ! files=$(git diff --name-only "$1...$2") || [[ -z $files ]]; then
  echo all
  exit 0
fi

units=()
while IFS= read -r file; do
  case $file in
    crates/thalvi-desktop/*) units+=(desktop app) ;;
    crates/thalvi-app/ui/*) units+=(desktop-ui) ;;
    crates/thalvi-app/src/*) units+=(app) ;;
    speech/*) units+=(speech) ;;
    .github/scripts/issue-refs*) units+=(issues) ;;
    *.md)
      if [[ $file == crates/* ]]; then
        echo all
        exit 0
      fi
      ;;
    *)
      echo all
      exit 0
      ;;
  esac
done <<< "$files"

if (( ${#units[@]} == 0 )); then
  echo none
  exit 0
fi

for unit in desktop app desktop-ui speech issues; do
  if [[ " ${units[*]} " == *" $unit "* ]]; then echo "$unit"; fi
done | paste -sd ' '
