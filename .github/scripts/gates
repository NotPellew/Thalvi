#!/usr/bin/env bash
# Runs a component's gates, the same commands CI runs; stops at the first failure.
# Toolchains and system packages are installed outside this script; each gate lists what it needs.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/../.."

SHELLCHECK=(pipx run --spec shellcheck-py==0.11.0.1 shellcheck)
components=(server desktop-windows desktop-ui speech issue-sync release formal)

step() {
  printf '\n==> %s\n' "$*"
  "$@"
}

in_dir() {
  local dir=$1
  shift
  printf '\n==> (in %s) %s\n' "$dir" "$*"
  (cd "$dir" && "$@")
}

desktop_ui() {
  step npm ci --prefix crates/thalvi-app/ui
  step npm run build --prefix crates/thalvi-app/ui
}

node_checks() {
  local dir=$1
  in_dir "$dir" npm ci
  in_dir "$dir" npm run typecheck
  in_dir "$dir" npm run lint
  in_dir "$dir" npm test
  in_dir "$dir" npm run build
}

# TESTS (cargo package arguments, or `none`) and BUNDLE=false narrow a gate to what a change affects:
# CI sets both from `changed`, and AGENTS.md says when to set them locally.
tests() {
  local packages=${TESTS:-$1}
  if [[ $packages == none ]]; then
    echo "SKIPPED cargo test: no tested crate changed"
  else
    # shellcheck disable=SC2086 # cargo package arguments
    step cargo test $packages --locked
  fi
}

stage_windows_webgpu() {
  local target_dir=${CARGO_TARGET_DIR:-$PWD/target}
  local out=crates/thalvi-app/helpers/webgpu
  step cargo build --release --locked -p thalvi-app
  mkdir -p "$out"
  for dll in webgpu_dawn.dll dxcompiler.dll; do
    local src="$target_dir/release/$dll"
    if [[ ! -f $src && -n ${LOCALAPPDATA:-} ]]; then
      src=$(find "$LOCALAPPDATA/ort.pyke.io" -name "$dll" -type f 2>/dev/null | head -n 1 || true)
    fi
    if [[ ! -f $src ]]; then
      echo "gates: missing Windows WebGPU runtime $dll in $target_dir/release" >&2
      exit 1
    fi
    cp "$src" "$out/$dll"
  done
}

bundle() {
  if [[ ${BUNDLE:-true} == false ]]; then
    echo "SKIPPED the $1 package: BUNDLE=false; it did not run and is not reported as passed"
  else
    local extra=()
    if [[ $1 == nsis ]]; then
      stage_windows_webgpu
      extra=(--config tauri.webgpu.windows.json)
    fi
    step .github/scripts/whisper-helper crates/thalvi-app/helpers/whisper
    in_dir crates/thalvi-app "${@:2}" npm exec --prefix ui -- tauri build --bundles "$1" \
      --config tauri.whisper.json "${extra[@]}" -- --locked
  fi
}

# Needs the Rust toolchain, Node pinned in .node-version, Python pinned in .python-version and, on Linux,
# libasound2-dev libwebkit2gtk-4.1-dev libayatana-appindicator3-dev. The package also needs what
# whisper-helper builds with: git, cmake, a C++ compiler and libvulkan-dev glslc spirv-headers.
gate_server() {
  desktop_ui
  step cargo fmt --all -- --check
  step python3 .github/scripts/rust-layout
  step .github/scripts/rust-layout.test.sh
  step .github/scripts/lint-exceptions
  step python3 .github/scripts/lint-exceptions.test.py
  step cargo lint
  tests --workspace
  RUSTDOCFLAGS="-D warnings" step cargo docs
  # linuxdeploy looks for libwebgpu_dawn.so, which the build links into the target folder, on this path.
  # The Vulkan loader stays the system's, which comes with the driver; Dawn would load a bundled one.
  bundle appimage env LD_LIBRARY_PATH="${CARGO_TARGET_DIR:-$PWD/target}/release" \
    LINUXDEPLOY_EXCLUDED_LIBRARIES='libvulkan.so*'
}

# Needs the server gate's toolchains on windows-latest, with the Vulkan SDK that vulkan-sdk.ps1 installs
# in place of the Linux packages, and runs from Git Bash.
gate_desktop_windows() {
  desktop_ui
  step cargo fmt --all -- --check
  step cargo lint
  PATH="${CARGO_TARGET_DIR:-$PWD/target}/debug:$PATH" tests "-p thalvi-desktop -p thalvi-app"
  bundle nsis
}

# Needs Node pinned in .node-version and, on Linux, the system libraries Chromium needs: ubuntu-latest has
# them; elsewhere `npm exec --prefix crates/thalvi-app/ui -- playwright-core install-deps chromium` as root.
gate_desktop_ui() {
  node_checks crates/thalvi-app/ui
  # Fetches the headless shell playwright-core pins.
  in_dir crates/thalvi-app/ui npm exec -- playwright-core install --only-shell chromium
  in_dir crates/thalvi-app/ui npm run layout
  in_dir crates/thalvi-app/ui npm run explore
}

# Needs pipx and uv (Python pinned in speech/asr/.python-version).
gate_speech() {
  step "${SHELLCHECK[@]}" speech/nemotron-asr.sh
  in_dir speech/asr uv run --frozen ruff check
  in_dir speech/asr uv run --frozen ruff format --check
  in_dir speech/asr uv run --frozen pytest
}

# Needs pipx, git, perl and python3.
gate_issue_sync() {
  step "${SHELLCHECK[@]}" .github/scripts/gates .github/scripts/whisper-helper .github/scripts/issue-refs.sh .github/scripts/issue-refs.test.sh \
    .github/scripts/changed .github/scripts/changed.test.sh .github/scripts/rust-layout.test.sh \
    .github/scripts/break-it .github/scripts/break-it.test.sh
  step .github/scripts/issue-refs.test.sh
  step .github/scripts/break-it.test.sh
  step .github/scripts/changed.test.sh
  step python3 .github/scripts/required-checks.test.py
}

# Needs Node pinned in .node-version, minisign, jq and pipx.
gate_release() {
  step npm ci --ignore-scripts --prefix crates/thalvi-app/ui
  step "${SHELLCHECK[@]}" .github/scripts/updater-feed .github/scripts/updater-feed.test.sh \
    .github/scripts/newer-version .github/scripts/newer-version.test.sh
  step .github/scripts/updater-feed.test.sh
  step .github/scripts/newer-version.test.sh
}

# The hash checks need Python pinned in .python-version, standard library only. Each formal skill a run
# selects (.agents/skills/formal-*) names what its checker needs.
gate_formal() {
  step python3 .github/scripts/formal-source-hashes.py
  step python3 .github/scripts/formal-source-hashes.test.py
  step python3 .github/scripts/formal-checks.test.py
  step python3 .github/scripts/formal-checks.py
}

run_component() {
  case $1 in
    server) gate_server ;;
    desktop-windows) gate_desktop_windows ;;
    desktop-ui) gate_desktop_ui ;;
    speech) gate_speech ;;
    issue-sync) gate_issue_sync ;;
    release) gate_release ;;
    formal) gate_formal ;;
  esac
}

run_all() {
  local runnable skipped reason component
  case $(uname -s) in
    Linux)
      runnable=(server desktop-ui speech issue-sync release formal)
      skipped=(desktop-windows)
      reason="needs Windows"
      ;;
    MINGW* | MSYS* | CYGWIN*)
      runnable=(desktop-windows)
      skipped=(server desktop-ui speech issue-sync release formal)
      reason="CI runs it on Linux"
      ;;
    *)
      echo "gates: no gates run on $(uname -s)" >&2
      exit 1
      ;;
  esac
  for component in "${runnable[@]}"; do
    printf '\n##### gates %s\n' "$component"
    run_component "$component"
  done
  printf '\n'
  for component in "${skipped[@]}"; do
    echo "SKIPPED $component ($reason); it did not run and is not reported as passed"
  done
  echo "PASSED ${runnable[*]}"
}

usage() {
  echo "usage: gates <component>" >&2
  echo "components: ${components[*]} all" >&2
}

if [[ $# -ne 1 ]]; then
  usage
  exit 2
fi

if [[ $1 == all ]]; then
  run_all
  exit 0
fi

for component in "${components[@]}"; do
  if [[ $1 == "$component" ]]; then
    run_component "$component"
    printf '\nPASSED %s\n' "$component"
    exit 0
  fi
done

echo "gates: unknown component '$1'" >&2
usage
exit 2
