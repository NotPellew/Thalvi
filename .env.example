# Copy to .env. Every endpoint is swappable: point it at any server that
# speaks the same protocol.

# Server
THALVI_ADDR=127.0.0.1:8080
THALVI_WEB_DIR=web/dist

# Language model: any OpenAI Chat Completions endpoint (Meta, Ollama, vLLM).
LLM_BASE_URL=https://api.meta.ai/v1
LLM_MODEL=muse-spark-1.3
LLM_API_KEY=
# Optional; minimal keeps spoken replies fast. Leave empty for the server default.
LLM_REASONING_EFFORT=minimal

# Speech to text: Meta realtime ASR protocol.
STT_URL=wss://api.meta.ai/v1/asr/realtime
STT_MODEL=muse-voice-transcribe-1.0
STT_API_KEY=

# Text to speech. TTS_API is the protocol TTS_BASE_URL speaks:
#   qwen3: a Qwen3-TTS server's framed PCM stream (GPU).
#   openai: any OpenAI /audio/speech endpoint that streams 24 kHz PCM, such as
#     Kokoro on CPU (TTS_BASE_URL=http://127.0.0.1:8880/v1, TTS_VOICE=af_heart).
TTS_API=qwen3
TTS_BASE_URL=http://127.0.0.1:8001/v1
# For qwen3, the voice id POST /v1/voices returned (see README).
TTS_VOICE=
# Read for openai only.
TTS_MODEL=kokoro
TTS_API_KEY=

# Optional short spoken acknowledgement while a slow reply is thought up.
# Off by default; set to on to enable (on/off).
THALVI_ACK=off

# Optional recordings for improving Thalvi, its models and endpoints.
# Comma-separated subset of metrics, text, audio. Unset or empty (the
# default) records nothing.
THALVI_RECORD=
# Where recordings are written. Defaults to data when unset.
THALVI_DATA_DIR=data
