# Copy to .env. Every endpoint is swappable: point it at any server that
# speaks the same protocol.

# Server
THALVI_ADDR=127.0.0.1:8080
THALVI_WEB_DIR=web/dist

# Language model: any OpenAI Chat Completions endpoint (Meta, Ollama, vLLM).
LLM_BASE_URL=https://api.meta.ai/v1
LLM_MODEL=muse-spark-1.3
LLM_API_KEY=
# Optional; minimal keeps spoken replies fast. Leave empty for the server default.
LLM_REASONING_EFFORT=minimal
# Optional. on sends what you said as audio instead of its transcript (voice
# turns only); the model must accept OpenAI input_audio parts. Off by default.
LLM_AUDIO_INPUT=off

# Optional background model that titles saved conversations in 3-6 words after
# the first reply. Set all three or none; without them a title is the first
# line you said. A model that reasons first is fine: no output cap is sent.
# BG_LLM_BASE_URL=https://inference.baseten.co/v1
# BG_LLM_MODEL=meta-models/muse-spark-open-1026
# BG_LLM_API_KEY=

# Speech to text: Meta realtime ASR protocol.
STT_URL=wss://api.meta.ai/v1/asr/realtime
STT_MODEL=muse-voice-transcribe-1.0
STT_API_KEY=

# Text to speech; see "Speech" in README.md for the three engines. TTS_API is
# the protocol TTS_BASE_URL speaks:
#   openai: an OpenAI /audio/speech endpoint that streams 24 kHz PCM
#     (vLLM-Omni, Kokoro).
#   qwen3: qwentts.cpp's framed PCM stream, for GPUs vLLM-Omni can't use
#     (speech/qwentts.sh prints the three lines).
# Qwen3-TTS clone on vLLM-Omni (docker compose --profile vllm-omni):
TTS_API=openai
TTS_BASE_URL=http://127.0.0.1:8091/v1
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
TTS_VOICE=af_heart
# Optional comma-separated voices the app's Voice picker offers, each previewed
# and applied per browser; TTS_VOICE is the default and always offered first.
# Unset offers only TTS_VOICE.
# TTS_VOICES=af_heart,af_bella
# Kokoro on CPU (docker compose --profile kokoro): TTS_BASE_URL=http://127.0.0.1:8880/v1,
# TTS_MODEL=kokoro, TTS_VOICE=af_heart.
# Read for openai only.
TTS_API_KEY=

# Optional short spoken acknowledgement while a slow reply is thought up.
# Off by default; set to on to enable (on/off).
THALVI_ACK=off

# Optional recordings for improving Thalvi, its models and endpoints.
# Comma-separated subset of metrics, text, audio. Unset or empty (the
# default) records nothing.
THALVI_RECORD=
# Where recordings, saved conversations (sessions/) and durable learnings are
# written. Defaults to data when unset.
THALVI_DATA_DIR=data

# Optional retirement of old conversations. Unset or off changes nothing. Set to
# 90 to replace sessions older than 90 days with a summary and durable learnings.
THALVI_RETIRE_DAYS=off

# Optional quality judge for `cargo run --release --bin measure` (see "Measure
# a setup" in README.md): any OpenAI-compatible model. Unset means replies are
# timed but not graded.
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=
